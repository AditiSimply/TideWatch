# Tidewatch Backend Environment Configuration
# Copy this file to .env and fill in your actual values.

# -----------------------------------------------------------------------
# DATABASE (Neon Postgres Pooled Connection)
# -----------------------------------------------------------------------
# For Neon Postgres, use the pooled connection string (port 5432):
#   postgresql+asyncpg://username:password@your-region.neon.tech/neondb?sslmode=require
#
# For local development, SQLite works out of the box:
DATABASE_URL=sqlite+aiosqlite:///./tidewatch.db

# -----------------------------------------------------------------------
# LLM PROVIDER
# -----------------------------------------------------------------------
# Choose: groq | ollama | huggingface
# The backend automatically cascades through configured providers on failure.
LLM_PROVIDER=groq

# ── Groq (cloud, free tier available) ──────────────────────────────────
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (local, no API key needed) ──────────────────────────────────
# Run Ollama locally: https://ollama.com/download
# Then pull a model: ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# ── HuggingFace (cloud, requires API token) ─────────────────────────────
# Get your token from: https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# -----------------------------------------------------------------------
# CORS Origins (comma-separated list)
# -----------------------------------------------------------------------
# Allows the Vite frontend dev server and any deployed Vercel origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------
# Set to "production" to disable the POST /llm/provider runtime switch.
ENV=development

# -----------------------------------------------------------------------
# ML Artifacts Directory
# -----------------------------------------------------------------------
# Where model.joblib, scaler.joblib, label_encoder.joblib, features.json,
# metrics.json, and test_samples.csv are stored.
MODEL_ARTIFACTS_DIR=artifacts
SIMULATION_DATA_PATH=artifacts/test_samples.csv

# -----------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------
LOG_LEVEL=INFO
